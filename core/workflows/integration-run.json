{
  "version": 1,
  "name": "integration-run",
  "phases": [
    {
      "id": "merge-preview",
      "owner": "harness-core",
      "exit": "preview-ready"
    },
    {
      "id": "conflict-resolution",
      "owner": "branch-integration",
      "entry": "conflict-detected",
      "exit": "conflicts-resolved-or-user-decision-required"
    },
    {
      "id": "verification",
      "owner": "verification-and-review",
      "entry": "preview-ready-or-conflicts-resolved",
      "exit": "integration-verified"
    },
    {
      "id": "merge-approval",
      "owner": "user",
      "entry": "integration-verified",
      "exit": "merged"
    }
  ],
  "conflictPolicy": {
    "semanticConflictRequiresUserDecision": true,
    "sameBaseBranchIsSerialized": true,
    "neverAutoResolveSilently": true
  }
}
