{
  "version": 1,
  "name": "feature-run",
  "inputPolicy": {
    "requiredFromUser": [
      "intent"
    ],
    "optionalFromUser": [
      "context",
      "evidence",
      "constraints",
      "acceptanceCriteria"
    ],
    "phaseInstructionsOptional": true,
    "modelSelectionUserOwned": false,
    "userProposedSolutionIsHypothesis": true
  },
  "entrypoint": {
    "owner": "harness-bootstrap",
    "accepts": "intent",
    "createsOneDerivedWorktree": true,
    "createsOrcaRun": true,
    "createsCoordinatorTask": true,
    "createsOneFeatureAgent": true,
    "createsChildTasks": false,
    "coordinatorPhase": "feature-orchestration",
    "mustRunBeforeProjectInspection": true,
    "trigger": "first-behavior-changing-request-in-any-session",
    "automaticFromDirectSession": true,
    "userRunsBootstrap": false,
    "baseBranchSource": "current-checked-out-branch-head",
    "dirtyBasePolicy": "fork-from-base-head-and-preserve",
    "boundRunPolicy": "resume-existing-bound-run",
    "entrySessionHandoff": "feature-agent",
    "normalWorkflowUsesPreview": false,
    "previewOnlyFor": [
      "harness-tests",
      "explicit-dry-run"
    ],
    "userChoosesModel": false,
    "userChoosesWorktree": false
  },
  "coordinator": {
    "skill": "feature-orchestration",
    "route": "coordinator",
    "role": "feature-agent",
    "userFacing": true,
    "ownsUserConversation": true,
    "ownsFeatureRunState": true,
    "ownsUserGates": true,
    "singleSession": true,
    "createsChildTasks": false,
    "workerPhase": false
  },
  "userConversation": {
    "owner": "feature-agent",
    "transport": "feature-agent-chat",
    "userGateTransport": "feature-agent-chat",
    "orcaAskForUserGate": false,
    "internalMessagesVisible": false,
    "mustExplainBeforeQuestion": true,
    "waitsForUserReplyInSameSession": true
  },
  "intake": {
    "owner": "feature-orchestration",
    "execution": "automatic-before-requirements",
    "workerPhase": false,
    "defaultWorkflow": "feature-run",
    "featureRunWhen": [
      "code-change",
      "test-change",
      "schema-or-migration-change",
      "configuration-change",
      "permission-or-security-change",
      "external-contract-change",
      "runtime-behavior-change"
    ],
    "nonMutatingWhen": [
      "explanation-only",
      "investigation-only",
      "review-only",
      "mechanical-non-behavioral-change"
    ]
  },
  "worktreePolicy": {
    "oneWorktreePerRun": true,
    "baseBranchIsWriteProtectedDuringRun": true,
    "derivedBranchPrefix": "orch/",
    "runtimeBranchAuthority": true,
    "runtimeBranchValidation": "final-path-segment-equals-feature-id",
    "runtimeOwnerPrefixAllowed": true,
    "resumeUsesExistingRunTaskAndWorktree": true
  },
  "executionPolicy": {
    "requiresBoundOrcaRun": true,
    "requiresTaskForWorkerDispatch": false,
    "requiresFeatureTask": true,
    "childTaskDefault": "disabled",
    "userGateOwner": "feature-agent",
    "implementationRequiresExplicitDesignApproval": true,
    "genericContinuationIsNotApproval": true,
    "progressReporting": {
      "required": true,
      "events": ["phase_started", "gate_waiting", "phase_completed", "blocked"]
    }
  },
  "skillRouting": {
    "readFullOrchestratorFirst": true,
    "loadOnlyCurrentPhaseAndAffectedBoundary": true,
    "routingReceiptRequired": false,
    "phases": {
      "requirements-analysis": {
        "skills": ["requirements-analysis", "architecture", "affected-domain", "test"],
        "productMutation": "read-only"
      },
      "architecture-design": {
        "skills": ["architecture-design", "architecture", "affected-domain"],
        "productMutation": "read-only"
      },
      "implementation": {
        "skills": ["implementation", "affected-domain", "test"],
        "productMutation": "allowed-after-user-approved"
      },
      "verification-and-review": {
        "skills": ["verification-and-review", "test", "affected-domain"],
        "productMutation": "verification-only"
      },
      "branch-integration": {
        "skills": ["branch-integration", "test"],
        "productMutation": "merge-preview-until-approved"
      }
    }
  },
  "phases": [
    {
      "id": "requirements-analysis",
      "skill": "requirements-analysis",
      "route": "requirements-analysis",
      "entry": "prepared",
      "exit": "user-confirmed",
      "workerRequired": false
    },
    {
      "id": "architecture-design",
      "skill": "architecture-design",
      "route": "architecture-design",
      "entry": "user-confirmed",
      "exit": "user-approved",
      "workerRequired": false
    },
    {
      "id": "implementation",
      "skill": "implementation",
      "route": "implementation",
      "entry": "user-approved",
      "exit": "implementation-ready-for-review",
      "workerRequired": false,
      "requiredApproval": "user-approved",
      "approval": {
        "type": "explicit-design-approval",
        "sourcePhase": "architecture-design",
        "decision": "approve",
        "genericContinuationAccepted": false
      }
    },
    {
      "id": "verification-and-review",
      "skill": "verification-and-review",
      "route": "verification-and-review",
      "entry": "implementation-ready-for-review",
      "exit": "verified-for-integration",
      "workerRequired": false
    },
    {
      "id": "branch-integration",
      "skill": "branch-integration",
      "route": "branch-integration",
      "entry": "verified-for-integration",
      "exit": "user-approved-for-merge",
      "workerRequired": false
    }
  ],
  "completion": {
    "requiresProjectFeatureDocument": true,
    "requiresDeterministicVerification": true,
    "pushRequiresSeparateApproval": true
  }
}
