{
  "version": 1,
  "source": {
    "name": "Arena Agent leaderboard",
    "overallUrl": "https://arena.ai/leaderboard/agent",
    "codeUrl": "https://arena.ai/leaderboard/agent/code",
    "snapshotPolicy": "freeze-at-feature-run-start",
    "requiredEvidence": [
      "capturedAt",
      "category",
      "modelName",
      "rankOrSignal",
      "sessions"
    ]
  },
  "fastPolicy": {
    "defaultEnabled": false,
    "explicitPromptOptIn": true,
    "marker": "fast",
    "scope": "feature-run",
    "defaultServiceTier": "default",
    "fastServiceTier": "priority",
    "toggleCommand": "/fast",
    "unsupportedRoute": "report-and-ask"
  },
  "routes": {
    "coordinator": {
      "provider": "claude",
      "model": "claude-opus-5",
      "effort": null,
      "fastCommand": "/fast",
      "arenaCategory": "code",
      "arenaEvidence": "Claude Opus 5 (High or Max)"
    },
    "feature-orchestration": {
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "effort": "high",
      "fastCommand": "/fast",
      "arenaCategory": "overall",
      "arenaEvidence": "GPT 5.6 Sol (xHigh)"
    },
    "requirements-analysis": {
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "effort": "high",
      "fastCommand": "/fast",
      "arenaCategory": "overall",
      "arenaEvidence": "GPT 5.6 Sol (xHigh)"
    },
    "architecture-design": {
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "effort": "high",
      "fastCommand": "/fast",
      "arenaCategory": "overall",
      "arenaEvidence": "GPT 5.6 Sol (xHigh)"
    },
    "implementation": {
      "provider": "claude",
      "model": "claude-opus-5",
      "effort": null,
      "fastCommand": "/fast",
      "arenaCategory": "code",
      "arenaEvidence": "Claude Opus 5 (High or Max)"
    },
    "verification-and-review": {
      "provider": "codex",
      "model": "gpt-5.6-luna",
      "effort": "xhigh",
      "fastCommand": "/fast",
      "arenaCategory": "code",
      "arenaEvidence": "GPT 5.6 Luna (xHigh)"
    },
    "branch-integration": {
      "provider": "claude",
      "model": "claude-opus-5",
      "effort": null,
      "fastCommand": "/fast",
      "arenaCategory": "code",
      "arenaEvidence": "Claude Opus 5 (High or Max)",
      "reviewProvider": "codex",
      "reviewModel": "gpt-5.6-luna",
      "reviewEffort": "xhigh"
    }
  },
  "riskOverrides": {
    "low": {
      "requirements-analysis": {
        "effort": "medium"
      },
      "architecture-design": {
        "effort": "medium"
      }
    },
    "high": {
      "requirements-analysis": {
        "effort": "xhigh"
      },
      "architecture-design": {
        "effort": "xhigh"
      }
    }
  },
  "fallbackPolicy": {
    "provider": "codex",
    "model": "gpt-5.6-sol",
    "effort": "high",
    "trigger": "quota-or-provider-unavailable",
    "sameFeatureRun": true,
    "sameTask": true,
    "sameWorktree": true,
    "unavailable": "resume-with-configured-fallback",
    "materialCostChange": "report-and-ask",
    "arenaSnapshotStale": "use-last-approved-and-report"
  }
}
