{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-harness.local/contracts/merge-receipt.schema.json",
  "title": "Branch merge receipt",
  "type": "object",
  "required": [
    "featureId",
    "baseBranch",
    "featureBranch",
    "verified",
    "verification",
    "projectFeatureDocument",
    "userApproval"
  ],
  "properties": {
    "featureId": {
      "type": "string"
    },
    "baseBranch": {
      "type": "string"
    },
    "featureBranch": {
      "type": "string"
    },
    "mergedCommit": {
      "type": "string"
    },
    "verified": {
      "const": true
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "projectFeatureDocument": {
      "type": "string",
      "minLength": 1
    },
    "userApproval": {
      "const": true
    }
  }
}
