{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-harness.local/contracts/handoff.schema.json",
  "title": "Feature phase handoff",
  "type": "object",
  "required": [
    "phase",
    "status",
    "understanding",
    "evidence",
    "openQuestions",
    "nextGate"
  ],
  "properties": {
    "phase": {
      "type": "string"
    },
    "status": {
      "enum": [
        "ready",
        "blocked",
        "needs-user-decision",
        "complete"
      ]
    },
    "understanding": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changedFiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nextGate": {
      "enum": [
        "inform",
        "confirm",
        "approve",
        "stop",
        "none"
      ]
    }
  }
}
